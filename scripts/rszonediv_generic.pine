//
// RSI momentum-divergence detector over RSIZones adaptive bands (Red heat overbought / Blue heat oversold).
// Reference version: 362-generic — Step 5 of the library-generic refactor. Per-side state machine is
// eng.step(dir, ZoneState, body, wick, …, SidePrev). Types + step() come from published
// RSIZoneDivEng/2 (inCore/inWide/inZone/intensity/wideExit). All [1] reads stay on flat globals.

indicator('RSI Zone Divergence Generic', shorttitle = 'RSIZGen', overlay = true)
import theansweris42/RSIZones/1 as mt
import theansweris42/RSIZoneDivEng/2 as eng

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// User Inputs
l_rsi = input(14, title = 'RSI Length')
ip_lx = input.float(20.0, maxval = 50, title = 'Crossover Offset (L) [RSI]')
ip_hx = input.float(20.0, maxval = 50, title = 'Crossover Offset (H) [RSI]')
ip_th = input.float(20.0, minval = 1, maxval = 50, title = 'Trigger Hysteresis (\\) [RSI]')
ip_rh = input.float(25.0, minval = 1, maxval = 50, title = 'Rebound Hysteresis (/) [RSI]')
l_trig = input.bool(false, title = 'High Sensitivity Trigger Enabled')

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// Band Signals ///
var mint1 = mt.mint.new()

float rsi1 = nz(ta.rsi(ohlc4, l_rsi), 50)

float rz0_hys = 5
float rz1_hys = 5

mint1.calc(rsi1, ip_lx, ip_hx, ip_rh, ip_th, rz0_hys, rz1_hys)

m_mid = 50.0
mp_tol = 0.25

// Hoisted stateful library method results (v6 lazy-eval fix): these methods wrap ta.* history calls,
// so they MUST execute on every bar. Under v6 'and'/'or'/ternary lazy evaluation, a call on the
// short-circuited side is skipped, corrupting the method's internal rolling history. Compute once per bar.
m_no_rzl_rise = mint1.no_rzl_rise()
m_no_rzl_fall = mint1.no_rzl_fall()
m_is_rzl_w_fall = mint1.is_rzl_w_fall()
m_no_rzh_rise = mint1.no_rzh_rise()
m_no_rzh_fall = mint1.no_rzh_fall()
m_is_rzh_fall = mint1.is_rzh_fall()
m_is_rzh_w_fall = mint1.is_rzh_w_fall()

zsL = eng.ZoneState.new(mint1.rzl_0, mint1.rzl_w, mint1.rzl_x, mint1.rzl, m_no_rzl_rise, m_no_rzl_fall, m_is_rzl_w_fall, mint1.rsi1)
zsH = eng.ZoneState.new(bool(mint1.rzh_0), bool(mint1.rzh_w), bool(mint1.rzh_x), mint1.rzh, m_no_rzh_rise, m_no_rzh_fall, m_is_rzh_w_fall, mint1.rsi1)

// ------------------------------------------------------------------ LOW (bullish) SIDE: dir = +1
// Flat series so [1] is real series history. Copy inZone to field_0 before reading [1] (never zsL.inZone[1]).
rcl_sp = 0.0
rcl_rp = 0.0
rcl_zp = 0.0
rcl_st = 0.0
rpl_capture_state = 0.0
field_0 = zsL.inZone
p_lo = close < open ? close : open
ppl_con_b = p_lo
ppl_con_w = p_lo
ppl_scap = p_lo
ppl_rcap = p_lo
ppl_zcap = 0.0
mpl_con = zsL.mom
mpl_cap = m_mid
mpl_rcap = m_mid
mpl_zcap = m_mid
mrl_div_cnt = 0.0

prevL = eng.SidePrev.new(rcl_sp[1], rcl_rp[1], rcl_zp[1], rcl_st[1], rpl_capture_state[1], mt.to_float(field_0[1]), ppl_con_b[1], ppl_con_w[1], ppl_scap[1], ppl_rcap[1], ppl_zcap[1], mpl_con[1], mpl_cap[1], mpl_rcap[1], mpl_zcap[1], mrl_div_cnt[1])
outL = eng.step(1, zsL, p_lo, low, m_mid, mp_tol, l_trig, prevL)

rcl_sp := outL.sp
rcl_rp := outL.rp
rcl_zp := outL.zp
rcl_st := outL.st
rpl_capture_state := outL.capState
ppl_con_b := outL.conB
ppl_con_w := outL.conW
ppl_scap := outL.scap
ppl_rcap := outL.rcap
ppl_zcap := outL.zcap
mpl_con := outL.momCon
mpl_cap := outL.momCap
mpl_rcap := outL.momRcap
mpl_zcap := outL.momZcap
mrl_div_cnt := outL.divCnt
mpl_trig = outL.trig

plotshape(mpl_trig, style = shape.triangleup, size = size.small, location = location.belowbar, color = color.new(color.green, 0))

if mpl_trig
    alert(syminfo.ticker + ', ' + timeframe.period + ': W' + str.tostring(mrl_div_cnt) + ' @ ' + str.tostring(close), alert.freq_once_per_bar)

// ------------------------------------------------------------------ HIGH (bearish) SIDE: dir = -1
rch_sp = 0.0
rch_rp = 0.0
rch_zp = 0.0
rch_st = 0.0
rph_capture_state = 0.0
field_1 = zsH.inZone
p_hi = close > open ? close : open
pph_con_b = p_hi
pph_con_w = p_hi
pph_scap = p_hi
pph_rcap = p_hi
pph_zcap = 0.0
mph_con = zsH.mom
mph_cap = m_mid
mph_rcap = m_mid
mph_zcap = m_mid
mrh_div_cnt = 0.0

prevH = eng.SidePrev.new(rch_sp[1], rch_rp[1], rch_zp[1], rch_st[1], rph_capture_state[1], mt.to_float(field_1[1]), pph_con_b[1], pph_con_w[1], pph_scap[1], pph_rcap[1], pph_zcap[1], mph_con[1], mph_cap[1], mph_rcap[1], mph_zcap[1], mrh_div_cnt[1])
outH = eng.step(-1, zsH, p_hi, high, m_mid, mp_tol, l_trig, prevH)

rch_sp := outH.sp
rch_rp := outH.rp
rch_zp := outH.zp
rch_st := outH.st
rph_capture_state := outH.capState
pph_con_b := outH.conB
pph_con_w := outH.conW
pph_scap := outH.scap
pph_rcap := outH.rcap
pph_zcap := outH.zcap
mph_con := outH.momCon
mph_cap := outH.momCap
mph_rcap := outH.momRcap
mph_zcap := outH.momZcap
mrh_div_cnt := outH.divCnt
mph_trig = outH.trig

plotshape(mph_trig, style = shape.triangledown, size = size.small, location = location.abovebar, color = color.new(color.red, 0))

if mph_trig
    alert(syminfo.ticker + ', ' + timeframe.period + ': M' + str.tostring(mrh_div_cnt) + ' @ ' + str.tostring(close), alert.freq_once_per_bar)
